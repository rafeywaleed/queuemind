# --- Supabase (Project Settings → API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string (IPv4, works on Vercel). Used for the agent's LangGraph checkpointer.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Models (all free tiers) ---
GOOGLE_API_KEY=            # Gemini (aistudio.google.com) — reasoning lane
GOOGLE_API_KEYS=           # optional: comma-separated keys from separate projects; each adds its own quota to the pool
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=              # Groq (console.groq.com) — always-on fast lane (gpt-oss-20b)
GROQ_FAST_MODEL=openai/gpt-oss-20b
MAIN_MODEL_PROVIDER=gemini # set to "groq" to run the agent on gpt-oss-120b if Gemini quota runs out

# --- Self-hosted Llama on Colab (optional) ---
RUNTIME_SECRET=change-me   # shared secret the Colab notebook uses to register its tunnel URL

# --- Clinic ---
CLINIC_TIMEZONE=Asia/Karachi
