# --- Supabase (Project Settings → API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string (IPv4, works on Vercel). Used for the agent's LangGraph checkpointer.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Reasoning lane: the agent (free tiers; the pool spreads load across all of them) ---
GOOGLE_API_KEY=                 # Gemini (aistudio.google.com)
GOOGLE_API_KEYS=                # optional: comma-separated keys from separate projects; each adds its own quota
GEMINI_MODEL=gemini-3.8-flash
MISTRAL_API_KEY=                # optional: Mistral free tier (console.mistral.ai, "Experiment" plan)
MISTRAL_MODEL=ministral-14b-latest
GROQ_API_KEY=                   # Groq (console.groq.com): fast lane + last-resort reasoning
MAIN_MODEL_PROVIDER=gemini      # "groq" forces the agent onto gpt-oss-120b

# --- Fast lane: SMS drafts + intake (Colab Llama if running → Groq → Mistral → Gemini) ---
GROQ_FAST_MODEL=openai/gpt-oss-20b
MISTRAL_FAST_MODEL=ministral-8b-latest
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# --- Decision lane: Laya (System 1) ---
# Default: the official public Laya demo Space (free, wakes itself) — nothing to configure.
HF_TOKEN=                       # optional: free Hugging Face read token, raises the demo Space's GPU quota
LAYA_URL=                       # optional (dev): a local laya-serve, e.g. http://localhost:8000
LAYA_SPACE_URL=                 # optional: your own laya-serve deployment (Jev /v1/systemone API)
LAYA_PUBLIC_DEMO=1              # set 0 to never use the public demo
PATIENT_INTENT_CONFIDENCE=0.5   # Laya confidence needed to answer a patient text without the LLM
DECISION_CONFIDENCE=0.75        # Laya confidence needed to decide walk-in triage without the LLM

# --- Colab notebook (optional self-hosting) ---
RUNTIME_SECRET=change-me        # shared secret the notebook uses to register its tunnel URLs

# --- Clinic simulation ---
CLINIC_TIMEZONE=Asia/Karachi
SIM_SPEED=6                     # clinic minutes per real minute (6 → 10 s = 1 min)
SIM_WALKIN_MINUTES=9            # a walk-in about every N clinic minutes while the clock runs
